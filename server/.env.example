# Copy to .env for local overrides. Railway sets PORT itself; the others are
# optional. None of these are required for the server to run.

# Port the HTTP server binds to. Railway injects this automatically in
# production; defaults to 8081 when unset.
PORT=8081
NODE_ENV=production

# Upstash Redis REST credentials. When BOTH are set, POST /api/event issues
# an INCR against the Upstash REST API for install/uninstall counters. When
# either is missing, /api/event is a dormant no-op that still answers 204.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Key prefix used for the counters written to Upstash, e.g.
# "${HUB_STORE_PREFIX}events:install:CTF". Defaults to "hub:".
HUB_STORE_PREFIX=hub:
# Accounts normally inherit HUB_STORE_PREFIX. Private account-test deployments
# may keep lasting credentials in hub: while isolating all gameplay data.
# Leave unset for ordinary deployments; see docs/private-account-test-2026-09-18.md.
# HUB_ACCOUNT_STORE_PREFIX=hub:

# Optional Lights Out email/password accounts. Leave disabled until mail delivery,
# the account UI and the privacy disclosures are ready. Steam sign-in stays available.
HUB_ACCOUNTS_ENABLED=0
# Keep both off until client identity separation, queue/match synchronization,
# live-session revocation and private multiplayer validation are complete.
HUB_ACCOUNT_OWNERSHIP_ENABLED=0
HUB_ACCOUNT_GAMEPLAY_ENABLED=0
# Canonical browser origin, exactly (no trailing slash). HTTPS is required.
HUB_ACCOUNT_ORIGIN=https://lightsoutranked.com
# Optional Steam/admin callback override: exact HTTPS origin, no trailing slash.
# Defaults to HUB_ACCOUNT_ORIGIN, then https://lightsoutranked.com in production.
# Recording always uses HUB_RECORDING_ORIGIN instead.
# HUB_PUBLIC_ORIGIN=https://lightsoutranked.com
# Generate at least 32 random bytes; keep stable and private. Used to HMAC email
# indexes and rate-limit keys. Rotating this requires migrating those indexes.
HUB_ACCOUNT_SECRET=
# SMTP is the default. Use resend-https on Railway: SMTP is blocked below Pro.
# Resend HTTPS uses the same server-only restricted sending key in HUB_SMTP_PASSWORD;
# it requires HUB_SMTP_HOST=smtp.resend.com and HUB_SMTP_USER=resend.
HUB_MAIL_TRANSPORT=smtp
# Provider-independent SMTP; 465 uses TLS, 587 requires STARTTLS. Never disable TLS.
HUB_SMTP_HOST=
HUB_SMTP_PORT=465
HUB_SMTP_USER=
HUB_SMTP_PASSWORD=
HUB_SMTP_FROM=

# Ranked release rules come from the published BB5 manifest.
COMP_MATCH_SIZE=10
COMP_MAX_PARTY=5
COMP_VERSION_GATE=strict
COMP_LO_SCORE_LIMIT=7
COMP_LO_SCORE_LIMIT_FORCE=0
COMP_GAME_RULES_OVERRIDE=

# Conduct rollout controls (unset preserves existing defaults).
# COMP_QUEUE_PENALTIES_PAUSED=1 pauses all conduct sanctions and queue bans.
# COMP_NO_SHOW_PENALTIES_PAUSED=1 pauses only no-show charges and bans.
# COMP_TK_ENFORCE=1 permits malicious-friendly-harm sanctions from eligible evidence.
# COMP_COMBAT_VALIDATED_COLLECTORS=chcombat-1 admits this collector's evidence.
# COMP_COMBAT_RATINGS_ENABLED=0 keeps damage/assist performance out of match ratings.
# Cloudflare TURN key credentials. These remain server-side; clients receive only 10-minute
# ephemeral ICE credentials from GET /api/network/relay. Both are required for relay measurement.
COMP_TURN_KEY_ID=
COMP_TURN_API_TOKEN=

# Regional matchmaking uses fresh relay measurements. Limits never widen with queue wait.
COMP_TARGET_PING_MS=80
COMP_MAX_PING_MS=120
# Legacy test fixtures only: bypass additionally requires NODE_ENV=test. Never set in production.
# COMP_NETWORK_TEST_BYPASS=1

# Temporarily bypass existing queue bans and suppress new no-show/team-kill bans and RR deductions.
# Set to 1 during testing; remove or set to 0 to restore enforcement. Records are preserved.
COMP_QUEUE_PENALTIES_PAUSED=0

# Passive combat evidence is observation-only until private-match validation.
# Add chcombat-1 only after the matrix in docs/combat-evidence.md passes for the
# current game build. Empty keeps new damage out of penalties and ratings.
COMP_COMBAT_VALIDATED_COLLECTORS=
# Independently enables validated evidence-based team-harm sanctions.
# The global pause above always takes precedence.
COMP_TK_ENFORCE=0
